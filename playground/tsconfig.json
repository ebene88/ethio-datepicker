{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"], // ✅ add this line
    "paths": {
      "@/*": ["../src/*"] // ✅ matches the alias in vite.config.ts
    }
  },
  "include": ["src", "vite.config.ts"]
}
